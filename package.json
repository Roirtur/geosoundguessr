{
  "name": "geosoundguessr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build && tsup server/index.ts --format esm --platform node --target node20 --out-dir dist-server --no-splitting",
    "start": "node server/start.mjs",
    "test": "vitest run --config vitest.config.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "smoke:game": "node scripts/browser-game-smoke.mjs",
    "catalog:commons": "tsx scripts/refresh-commons-catalog.ts",
    "format": "prettier --write \"client/**/*.{ts,tsx,css}\" \"server/**/*.{ts,mjs}\" \"shared/**/*.ts\" \"scripts/**/*.{ts,mjs}\" vite.config.ts vitest.config.mjs index.html README.md",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@turf/boolean-point-in-polygon": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-globe.gl": "^2.36.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.181.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.181.0",
    "@types/topojson-client": "^3.1.5",
    "concurrently": "^9.2.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
